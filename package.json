{
  "name": "lachgas-amsterdam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "content:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content-audit.mts",
    "typecheck": "tsc --noEmit",
